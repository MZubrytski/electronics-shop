DATABASE_URL="postgresql://shop:shop@localhost:5432/shop?schema=public"
# Отдельная база для сквозных тестов: они чистят таблицы между тестами,
# и делать это с рабочей базой нельзя. Создаётся `npm run db:test:setup`.
DATABASE_URL_TEST="postgresql://shop:shop@localhost:5432/shop_test?schema=public"
PORT=3001
# Источник, которому разрешён CORS. На проде — адрес витрины.
WEB_ORIGIN="http://localhost:3000"
# 1 только там, где перед приложением реально стоит прокси (Render).
# Локально 0: иначе любой клиент подделает X-Forwarded-For и обойдёт лимит.
TRUST_PROXY=0

JWT_ACCESS_SECRET="замени-на-длинную-случайную-строку"
JWT_REFRESH_SECRET="замени-на-другую-длинную-случайную-строку"

# Общий секрет с витриной. С ним API доверяет адресу посетителя, который
# витрина присылает в x-client-address: в проде браузер в API не ходит, и без
# этого лимит на вход считался бы один на весь магазин.
INTERNAL_REQUEST_SECRET=""
# Включать только там, где перед приложением реально стоит прокси (Render).
# Локально — не включать: иначе любой сможет подделать свой адрес.
TRUST_PROXY="0"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""